{
  "cli": {
    "version": ">= 16.2.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true,
      "channel": "main",
      "ios": { "buildConfiguration": "Debug" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "main"
    },
    "production": {
      "autoIncrement": true,
      "channel": "main"
    },
    "offline": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "buildConfiguration": "Release" },
      "autoIncrement": true,
      "channel": "offline"
    }
  },
  "submit": {
    "production": {}
  }
}